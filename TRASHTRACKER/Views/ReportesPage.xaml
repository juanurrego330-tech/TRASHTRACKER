<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrashTracker.ViewModels"
             x:Class="TrashTracker.Views.ReportesPage"
             Title="Reportes">

    <ContentPage.BindingContext>
        <vm:ReportesViewModel />
    </ContentPage.BindingContext>

    <RefreshView Command="{Binding CargarCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Reportes}" Margin="15">

            <CollectionView.EmptyView>
                <Label Text="Aún no hay reportes." HorizontalOptions="Center" VerticalOptions="Center"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="0,0,0,10" StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                            <Image Source="{Binding FotoRuta}" WidthRequest="90" HeightRequest="90"
                                   Aspect="AspectFill" BackgroundColor="LightGray" VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding TipoResiduo}" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="{Binding Urgencia, StringFormat='Urgencia: {0}'}"/>
                                <Label Text="{Binding Estado, StringFormat='Estado: {0}'}"/>
                                <Label Text="{Binding Ubicacion}"/>
                                <Label Text="{Binding Descripcion}" FontSize="13"/>
                                <Label Text="{Binding Fecha}" FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding Reportante, StringFormat='Por: {0}'}" FontSize="12" TextColor="Gray"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </RefreshView>
</ContentPage>