<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrashTracker.ViewModels"
             x:Class="TrashTracker.Views.ReportesPage"
             Title="Reportes del campus">

    <ContentPage.BindingContext>
        <vm:ReportesViewModel />
    </ContentPage.BindingContext>

    <RefreshView Command="{Binding CargarCommand}" IsRefreshing="{Binding IsBusy}" RefreshColor="{StaticResource Primary}">
        <CollectionView ItemsSource="{Binding Reportes}" Margin="15,15,15,0">

            <CollectionView.EmptyView>
                <Label Text="Aún no hay reportes. Todo limpio por ahora (^_^)"
                       Style="{StaticResource Subtitulo}" VerticalOptions="Center" Margin="30"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,12" Padding="12">
                        <Grid ColumnDefinitions="92,*" ColumnSpacing="12">

                            <Image Source="{Binding FotoRuta}" WidthRequest="92" HeightRequest="92"
                                   Aspect="AspectFill" BackgroundColor="{StaticResource VerdeClaro}" VerticalOptions="Start"/>

                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding TipoResiduo}" FontFamily="OpenSansSemibold" FontSize="16"/>

                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Urgencia, StringFormat='Urgencia {0}'}"
                                           FontFamily="OpenSansSemibold" TextColor="{StaticResource VerdeOscuro}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Urgencia}" Value="Media">
                                                <Setter Property="TextColor" Value="{StaticResource Naranja}"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Urgencia}" Value="Alta">
                                                <Setter Property="TextColor" Value="{StaticResource Coral}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Estado}" TextColor="{StaticResource AzulOscuro}"/>
                                </HorizontalStackLayout>

                                <Label Text="{Binding Ubicacion}" TextColor="{StaticResource TextoSuave}"/>
                                <Label Text="{Binding Descripcion}" FontSize="13"/>
                                <Label Text="{Binding Fecha}" FontSize="12" TextColor="{StaticResource TextoSuave}"/>
                                <Label Text="{Binding Reportante, StringFormat='Por {0}'}" FontSize="12" TextColor="{StaticResource TextoSuave}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </RefreshView>
</ContentPage>