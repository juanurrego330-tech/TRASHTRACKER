<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrashTracker.ViewModels"
             x:Class="TrashTracker.Views.RecuperarPasswordPage"
             Title="Recuperar contraseña">

    <ContentPage.BindingContext>
        <vm:RecuperarPasswordViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="16" VerticalOptions="Center">

            <Label Text="Recuperar contraseña" Style="{StaticResource Titulo}"/>

            <VerticalStackLayout Spacing="14" IsVisible="{Binding EsPaso1}">
                <Label Text="Ingresa tu correo institucional y te enviaremos un código." Style="{StaticResource Subtitulo}"/>
                <Entry Placeholder="Correo institucional (@pascualbravo.edu.co)" Text="{Binding Correo}" Keyboard="Email"/>
                <Button Text="Enviar código" Command="{Binding EnviarCodigoCommand}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14" IsVisible="{Binding EsPaso2}">
                <Label Text="Ingresa el código que recibiste." Style="{StaticResource Subtitulo}"/>
                <Entry Placeholder="Código" Text="{Binding Codigo}"/>
                <Button Text="Verificar código" Command="{Binding VerificarCodigoCommand}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14" IsVisible="{Binding EsPaso3}">
                <Label Text="Crea tu nueva contraseña (mínimo 8 caracteres)." Style="{StaticResource Subtitulo}"/>
                <Entry Placeholder="Nueva contraseña" Text="{Binding NuevaPassword}" IsPassword="True"/>
                <Entry Placeholder="Confirmar contraseña" Text="{Binding ConfirmarPassword}" IsPassword="True"/>
                <Button Text="Cambiar contraseña" Command="{Binding CambiarPasswordCommand}"/>
            </VerticalStackLayout>

            <Button Text="Volver al login" Command="{Binding VolverCommand}" Style="{StaticResource BotonTexto}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>