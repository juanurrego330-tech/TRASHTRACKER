<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrashTracker.ViewModels"
             x:Class="TrashTracker.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             Title="Iniciar sesión">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="14" VerticalOptions="Center">

            <Image Source="logo_trashtracker.png" HeightRequest="150" HorizontalOptions="Center"/>
            <Label Text="TrashTracker" Style="{StaticResource Titulo}"/>
            <Label Text="Un campus limpio empieza por ti" Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>

            <Entry Placeholder="Correo institucional (@pascualbravo.edu.co)" Text="{Binding Correo}" Keyboard="Email"/>
            <Entry Placeholder="Contraseña" Text="{Binding Password}" IsPassword="True"/>

            <Button Text="Iniciar sesión" Command="{Binding LoginCommand}" Margin="0,8,0,0"/>
            <Button Text="¿Olvidaste tu contraseña?" Command="{Binding ForgotPasswordCommand}" Style="{StaticResource BotonTexto}"/>
            <Button Text="¿No tienes cuenta? Regístrate aquí" Command="{Binding NavigateToRegisterCommand}" Style="{StaticResource BotonSuave}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>