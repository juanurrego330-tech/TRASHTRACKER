<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrashTracker.ViewModels"
             x:Class="TrashTracker.Views.CreateReportPage"
             Title="Nuevo reporte">

    <ContentPage.BindingContext>
        <vm:CreateReportViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Reportar un problema de limpieza" Style="{StaticResource Titulo}" FontSize="22"/>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="12">
                    <Button Text="Tomar foto del residuo" Command="{Binding CapturePhotoCommand}" Style="{StaticResource BotonAzul}"/>
                    <Image Source="{Binding PhotoPath}" HeightRequest="180" Aspect="AspectFit" BackgroundColor="{StaticResource VerdeClaro}"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tipo de residuo" Style="{StaticResource Etiqueta}"/>
                    <Picker Title="Seleccione una categoría" SelectedItem="{Binding SelectedTipoResiduo}">
                        <Picker.Items>
                            <x:String>Orgánico</x:String>
                            <x:String>Reciclable</x:String>
                            <x:String>Peligroso / Vidrio</x:String>
                            <x:String>Escombros</x:String>
                        </Picker.Items>
                    </Picker>

                    <Label Text="Nivel de urgencia" Style="{StaticResource Etiqueta}" Margin="0,8,0,0"/>
                    <Picker Title="Seleccione la urgencia" SelectedItem="{Binding SelectedUrgencia}">
                        <Picker.Items>
                            <x:String>Baja</x:String>
                            <x:String>Media</x:String>
                            <x:String>Alta</x:String>
                        </Picker.Items>
                    </Picker>
                    <Label Text="Alta = riesgo para las personas o bloqueo de paso." FontSize="12" TextColor="{StaticResource TextoSuave}"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Bloque" Style="{StaticResource Etiqueta}"/>
                    <Picker Title="Seleccione el bloque" ItemsSource="{Binding Bloques}" SelectedItem="{Binding SelectedBloque}"/>

                    <Label Text="Piso" Style="{StaticResource Etiqueta}" Margin="0,8,0,0"/>
                    <Picker Title="Seleccione el piso" ItemsSource="{Binding Pisos}" SelectedItem="{Binding SelectedPiso}"/>

                    <Label Text="Descripción o referencia exacta" Style="{StaticResource Etiqueta}" Margin="0,8,0,0"/>
                    <Editor Placeholder="Ej. Cerca a las bancas..." Text="{Binding Descripcion}" HeightRequest="90"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="Enviar reporte" Command="{Binding SubmitReportCommand}" Margin="0,4,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>