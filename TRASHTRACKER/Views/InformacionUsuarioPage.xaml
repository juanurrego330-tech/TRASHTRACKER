<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrashTracker.ViewModels"
             x:Class="TrashTracker.Views.InformacionUsuarioPage"
             Title="Información Usuario">

    <ContentPage.BindingContext>
        <vm:InformacionUsuarioViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Tus datos" Style="{StaticResource Titulo}"/>
            <Label Text="Si algo quedó mal escrito, corrígelo aquí" Style="{StaticResource Subtitulo}"/>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nombre" Style="{StaticResource Etiqueta}"/>
                    <Entry Text="{Binding Nombre}"/>

                    <Label Text="Apellido" Style="{StaticResource Etiqueta}" Margin="0,8,0,0"/>
                    <Entry Text="{Binding Apellido}"/>

                    <Label Text="Correo institucional" Style="{StaticResource Etiqueta}" Margin="0,8,0,0"/>
                    <Label Text="{Binding Correo}" FontSize="16"/>

                    <Label Text="Rol" Style="{StaticResource Etiqueta}" Margin="0,8,0,0"/>
                    <Label Text="{Binding Rol}" FontSize="16"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="Guardar cambios" Command="{Binding GuardarCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>