<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrashTracker.ViewModels"
             x:Class="TrashTracker.Views.MenuPage"
             Title="{Binding Bienvenida}">

    <ContentPage.BindingContext>
        <vm:MenuViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="16" VerticalOptions="Center">

            <Image Source="logo_trashtracker.png" HeightRequest="130" HorizontalOptions="Center"/>
            <Label Text="¿Qué quieres hacer hoy?" Style="{StaticResource Subtitulo}" FontSize="16" Margin="0,0,0,10"/>

            <Button Text="Generar reporte" Command="{Binding GenerarReporteCommand}" HeightRequest="64" FontSize="17"/>
            <Button Text="Ver reportes" Command="{Binding VerReportesCommand}" Style="{StaticResource BotonAzul}" HeightRequest="64" FontSize="17"/>
            <Button Text="Información Usuario" Command="{Binding InformacionUsuarioCommand}" Style="{StaticResource BotonSuave}" HeightRequest="64" FontSize="17"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>