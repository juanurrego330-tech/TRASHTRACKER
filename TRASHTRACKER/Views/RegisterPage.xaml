<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TrashTracker.ViewModels"
             x:Class="TrashTracker.Views.RegisterPage"
             Title="Crear cuenta">

    <ContentPage.BindingContext>
        <vm:RegisterViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="14" VerticalOptions="Center">

            <Label Text="Únete a TrashTracker" Style="{StaticResource Titulo}"/>
            <Label Text="Crea tu cuenta con tu correo institucional" Style="{StaticResource Subtitulo}" Margin="0,0,0,10"/>

            <Entry Placeholder="Nombre" Text="{Binding Nombre}"/>
            <Entry Placeholder="Apellido" Text="{Binding Apellido}"/>
            <Entry Placeholder="Correo institucional (@pascualbravo.edu.co)" Text="{Binding Correo}" Keyboard="Email"/>
            <Entry Placeholder="Contraseña (mínimo 8 caracteres)" Text="{Binding Password}" IsPassword="True"/>

            <Button Text="Registrarse" Command="{Binding RegisterCommand}" Margin="0,8,0,0"/>
            <Button Text="¿Ya tienes cuenta? Inicia sesión" Command="{Binding GoToLoginCommand}" Style="{StaticResource BotonTexto}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>